# SQLite. Tres barras = ruta relativa (local), cuatro = absoluta.
# En Railway hay que apuntar al volumen para que los datos sobrevivan a un
# redespliegue:  sqlite:////data/parte_del_dia.db
# Si algún día se pasa a Postgres, basta con cambiar esta línea: el
# postgres:// que da Railway se normaliza solo a postgresql://.
DATABASE_URL=sqlite:///./parte_del_dia.db

# Zona horaria para fechas de apuntes y avisos.
TZ_LOCAL=Europe/Madrid

# Token del bot de Telegram, el que da @BotFather.
TELEGRAM_BOT_TOKEN=

# Hora local del resumen automático de cada noche.
HORA_AVISO=21:00

# Para transcribir las notas de voz del bot (platform.openai.com).
# Sin esto el bot sigue funcionando: avisa de que no sabe escuchar y el
# audio se queda en el chat de Telegram, que no se pierde nada.
OPENAI_API_KEY=
# Un minuto de audio cuesta menos de un céntimo con este modelo.
MODELO_TRANSCRIPCION=gpt-4o-mini-transcribe
# Idioma de las notas de voz. Decírselo evita que una nota de dos palabras
# salga transcrita en otro idioma.
IDIOMA_VOZ=es

# Tu id de Telegram (y el de quien quieras, separados por comas). Si la base
# deja de guardarse, el bot os escribe nada más arrancar. Sin esto avisa
# igual, pero solo cuando alguien le escribe. El id lo da @userinfobot.
ALARMA_TELEGRAM_IDS=

# Webs que pueden llamar a la API, separadas por comas. En local, el
# servidor de Vite; en Railway, la URL del front (sin barra al final).
CORS_ORIGENES=http://localhost:5173
